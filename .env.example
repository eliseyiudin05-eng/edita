OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

NEXT_PUBLIC_SITE_URL=https://kivronix.ru
NEXT_PUBLIC_PAID_PLANS_ENABLED=false
KIVRONIX_POINTS_REDEMPTION_ENABLED=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MODE=test

# Optional. Set only if YooKassa receipts are configured for the shop.
# Example VAT code depends on your tax setup; do not guess it.
YOOKASSA_VAT_CODE=

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=KIVRONIX <no-reply@auth.kivronix.ru>

# Isolated Go backend (v1.0.39 business-discussion shadow-read stage)
GO_BACKEND_ENV=development
GO_BACKEND_ADDRESS=:8080
GO_BACKEND_SUPABASE_URL=
GO_BACKEND_SUPABASE_PUBLISHABLE_KEY=
GO_BACKEND_DATABASE_URL=
GO_BACKEND_DATABASE_MAX_CONNS=4
GO_BACKEND_JWT_AUDIENCE=authenticated
GO_BACKEND_DEPENDENCY_TIMEOUT=3s
GO_BACKEND_JWKS_CACHE_TTL=5m
GO_BACKEND_JWKS_HTTP_TIMEOUT=5s
GO_BACKEND_PROFILE_HTTP_TIMEOUT=3s
GO_BACKEND_ACADEMY_HTTP_TIMEOUT=3s
GO_BACKEND_SOCIAL_HTTP_TIMEOUT=3s
GO_BACKEND_BUSINESS_HTTP_TIMEOUT=3s
GO_BACKEND_PRIVATE_CHAT_HTTP_TIMEOUT=3s
GO_BACKEND_AI_HISTORY_HTTP_TIMEOUT=3s

# Next.js migration controls. Keep both traffic modes disabled until Go is deployed and healthy.
GO_BACKEND_URL=
GO_BACKEND_SHADOW_READS_ENABLED=false
GO_BACKEND_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_CANARY_READS_ENABLED=false
# Canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_CANARY_PERCENT=1
GO_BACKEND_CANARY_TIMEOUT_MS=1000
GO_BACKEND_CANARY_MAX_LATENCY_MS=750
# Idempotent learning-preferences update canary. Keep disabled until profile reads are healthy.
GO_BACKEND_PROFILE_UPDATE_CANARY_ENABLED=false
# Update canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PROFILE_UPDATE_CANARY_PERCENT=1
GO_BACKEND_PROFILE_UPDATE_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PROFILE_UPDATE_CANARY_MAX_LATENCY_MS=750
# Profile-settings shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_PROFILE_SETTINGS_SHADOW_READS_ENABLED=false
GO_BACKEND_PROFILE_SETTINGS_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_PROFILE_SETTINGS_CANARY_READS_ENABLED=false
# Profile-settings canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PROFILE_SETTINGS_CANARY_PERCENT=1
GO_BACKEND_PROFILE_SETTINGS_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PROFILE_SETTINGS_CANARY_MAX_LATENCY_MS=750
# Idempotent profile-settings update canary. Apply the owner-only UPDATE policy before enabling.
GO_BACKEND_PROFILE_SETTINGS_UPDATE_CANARY_ENABLED=false
# Profile-settings update canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PROFILE_SETTINGS_UPDATE_CANARY_PERCENT=1
GO_BACKEND_PROFILE_SETTINGS_UPDATE_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PROFILE_SETTINGS_UPDATE_CANARY_MAX_LATENCY_MS=750
# Idempotent future-plan interest canary. Payments remain disabled and outside Go.
GO_BACKEND_PLAN_INTEREST_CANARY_ENABLED=false
# Plan interest canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PLAN_INTEREST_CANARY_PERCENT=1
GO_BACKEND_PLAN_INTEREST_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PLAN_INTEREST_CANARY_MAX_LATENCY_MS=750
# Idempotent AI-feedback canary. Comments that can queue learning candidates always stay on legacy.
GO_BACKEND_AI_FEEDBACK_CANARY_ENABLED=false
# AI-feedback canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_AI_FEEDBACK_CANARY_PERCENT=1
GO_BACKEND_AI_FEEDBACK_CANARY_TIMEOUT_MS=1000
GO_BACKEND_AI_FEEDBACK_CANARY_MAX_LATENCY_MS=750
# Academy progress shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_ACADEMY_SHADOW_READS_ENABLED=false
GO_BACKEND_ACADEMY_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_ACADEMY_CANARY_READS_ENABLED=false
# Academy canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_ACADEMY_CANARY_PERCENT=1
GO_BACKEND_ACADEMY_CANARY_TIMEOUT_MS=1000
GO_BACKEND_ACADEMY_CANARY_MAX_LATENCY_MS=750
# Social ranking shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_SOCIAL_SHADOW_READS_ENABLED=false
GO_BACKEND_SOCIAL_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_CANARY_READS_ENABLED=false
# Social canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_SOCIAL_CANARY_PERCENT=1
GO_BACKEND_SOCIAL_CANARY_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_CANARY_MAX_LATENCY_MS=750
# Friend-list shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_SOCIAL_FRIENDS_SHADOW_READS_ENABLED=false
GO_BACKEND_SOCIAL_FRIENDS_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_FRIENDS_CANARY_READS_ENABLED=false
# Friend-list canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_SOCIAL_FRIENDS_CANARY_PERCENT=1
GO_BACKEND_SOCIAL_FRIENDS_CANARY_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_FRIENDS_CANARY_MAX_LATENCY_MS=750
# Idempotent outgoing friendship cancellation canary. Keep disabled until friend reads are healthy and its RLS migration is applied.
GO_BACKEND_SOCIAL_FRIEND_CANCEL_CANARY_ENABLED=false
# Cancellation canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_SOCIAL_FRIEND_CANCEL_CANARY_PERCENT=1
GO_BACKEND_SOCIAL_FRIEND_CANCEL_CANARY_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_FRIEND_CANCEL_CANARY_MAX_LATENCY_MS=750
# Idempotent incoming friendship response canary. Keep disabled until its UPDATE RLS migration is applied.
GO_BACKEND_SOCIAL_FRIEND_RESPONSE_CANARY_ENABLED=false
# Response canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_SOCIAL_FRIEND_RESPONSE_CANARY_PERCENT=1
GO_BACKEND_SOCIAL_FRIEND_RESPONSE_CANARY_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_FRIEND_RESPONSE_CANARY_MAX_LATENCY_MS=750
# Idempotent practice-session save canary. Keep disabled until its RLS migration is applied.
GO_BACKEND_PRACTICE_SAVE_CANARY_ENABLED=false
# Practice save canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PRACTICE_SAVE_CANARY_PERCENT=1
GO_BACKEND_PRACTICE_SAVE_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PRACTICE_SAVE_CANARY_MAX_LATENCY_MS=750
# Practice-session shadow and canary reads are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_PRACTICE_SHADOW_READS_ENABLED=false
GO_BACKEND_PRACTICE_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_PRACTICE_CANARY_READS_ENABLED=false
# Practice read canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PRACTICE_CANARY_PERCENT=1
GO_BACKEND_PRACTICE_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PRACTICE_CANARY_MAX_LATENCY_MS=750
# Study-group shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_SOCIAL_GROUPS_SHADOW_READS_ENABLED=false
GO_BACKEND_SOCIAL_GROUPS_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_GROUPS_CANARY_READS_ENABLED=false
# Study-group canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_SOCIAL_GROUPS_CANARY_PERCENT=1
GO_BACKEND_SOCIAL_GROUPS_CANARY_TIMEOUT_MS=1000
GO_BACKEND_SOCIAL_GROUPS_CANARY_MAX_LATENCY_MS=750
# Business-verification shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_BUSINESS_VERIFICATION_SHADOW_READS_ENABLED=false
GO_BACKEND_BUSINESS_VERIFICATION_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_BUSINESS_VERIFICATION_CANARY_READS_ENABLED=false
# Business-verification canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_BUSINESS_VERIFICATION_CANARY_PERCENT=1
GO_BACKEND_BUSINESS_VERIFICATION_CANARY_TIMEOUT_MS=1000
GO_BACKEND_BUSINESS_VERIFICATION_CANARY_MAX_LATENCY_MS=750
# Editor-verification shadow and canary are mutually exclusive. Apply its owner-only SELECT migration first.
GO_BACKEND_EDITOR_VERIFICATION_SHADOW_READS_ENABLED=false
GO_BACKEND_EDITOR_VERIFICATION_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_EDITOR_VERIFICATION_CANARY_READS_ENABLED=false
# Editor-verification canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_EDITOR_VERIFICATION_CANARY_PERCENT=1
GO_BACKEND_EDITOR_VERIFICATION_CANARY_TIMEOUT_MS=1000
GO_BACKEND_EDITOR_VERIFICATION_CANARY_MAX_LATENCY_MS=750
# Guardian-verification shadow and canary are mutually exclusive. Apply its owner-only column SELECT migration first.
GO_BACKEND_GUARDIAN_VERIFICATION_SHADOW_READS_ENABLED=false
GO_BACKEND_GUARDIAN_VERIFICATION_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_GUARDIAN_VERIFICATION_CANARY_READS_ENABLED=false
# Guardian-verification canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_GUARDIAN_VERIFICATION_CANARY_PERCENT=1
GO_BACKEND_GUARDIAN_VERIFICATION_CANARY_TIMEOUT_MS=1000
GO_BACKEND_GUARDIAN_VERIFICATION_CANARY_MAX_LATENCY_MS=750
# Confidential business-discussion shadow read. Apply its business-only SELECT migration before enabling.
GO_BACKEND_BUSINESS_DISCUSSION_SHADOW_READS_ENABLED=false
GO_BACKEND_BUSINESS_DISCUSSION_SHADOW_TIMEOUT_MS=1000
# Private-chat thread shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_PRIVATE_CHAT_SHADOW_READS_ENABLED=false
GO_BACKEND_PRIVATE_CHAT_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_PRIVATE_CHAT_CANARY_READS_ENABLED=false
# Private-chat canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PRIVATE_CHAT_CANARY_PERCENT=1
GO_BACKEND_PRIVATE_CHAT_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PRIVATE_CHAT_CANARY_MAX_LATENCY_MS=750
# Private-chat list shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_PRIVATE_CHAT_LIST_SHADOW_READS_ENABLED=false
GO_BACKEND_PRIVATE_CHAT_LIST_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_PRIVATE_CHAT_LIST_CANARY_READS_ENABLED=false
# Private-chat list canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_PRIVATE_CHAT_LIST_CANARY_PERCENT=1
GO_BACKEND_PRIVATE_CHAT_LIST_CANARY_TIMEOUT_MS=1000
GO_BACKEND_PRIVATE_CHAT_LIST_CANARY_MAX_LATENCY_MS=750
# AI-history shadow and canary are mutually exclusive. Keep both disabled until Go is healthy.
GO_BACKEND_AI_HISTORY_SHADOW_READS_ENABLED=false
GO_BACKEND_AI_HISTORY_SHADOW_TIMEOUT_MS=1000
GO_BACKEND_AI_HISTORY_CANARY_READS_ENABLED=false
# AI-history canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_AI_HISTORY_CANARY_PERCENT=1
GO_BACKEND_AI_HISTORY_CANARY_TIMEOUT_MS=1000
GO_BACKEND_AI_HISTORY_CANARY_MAX_LATENCY_MS=750
# Idempotent AI-history deletion canary. Keep disabled until the read canary is healthy.
GO_BACKEND_AI_HISTORY_DELETE_CANARY_ENABLED=false
# Delete canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_AI_HISTORY_DELETE_CANARY_PERCENT=1
GO_BACKEND_AI_HISTORY_DELETE_CANARY_TIMEOUT_MS=1000
GO_BACKEND_AI_HISTORY_DELETE_CANARY_MAX_LATENCY_MS=750
# Idempotent AI-conversation creation canary. Keep disabled until AI-history writes are healthy.
GO_BACKEND_AI_CONVERSATION_CANARY_ENABLED=false
# Conversation canary accepts values above 0 through 10. Invalid values fall back to 1 percent.
GO_BACKEND_AI_CONVERSATION_CANARY_PERCENT=1
